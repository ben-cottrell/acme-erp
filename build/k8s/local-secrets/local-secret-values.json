{
  "stateValues": [
    {
      "name": "sql-sa-password",
      "length": 32
    },
    {
      "name": "sales-db-password",
      "length": 32
    },
    {
      "name": "purchasing-db-password",
      "length": 32
    },
    {
      "name": "inventory-db-password",
      "length": 32
    },
    {
      "name": "fulfilment-db-password",
      "length": 32
    },
    {
      "name": "authentik-secret-key",
      "length": 64,
      "sources": [
        {
          "secret": "authentik",
          "key": "AUTHENTIK_SECRET_KEY"
        },
        {
          "secret": "erp-authentik-bootstrap",
          "key": "secret-key"
        }
      ]
    },
    {
      "name": "authentik-postgresql-password",
      "length": 32,
      "sources": [
        {
          "secret": "authentik-postgresql",
          "key": "password"
        },
        {
          "secret": "authentik",
          "key": "AUTHENTIK_POSTGRESQL__PASSWORD"
        },
        {
          "secret": "erp-authentik-bootstrap",
          "key": "postgresql-password"
        }
      ]
    },
    {
      "name": "authentik-bootstrap-password",
      "length": 32,
      "sources": [
        {
          "secret": "authentik",
          "key": "AUTHENTIK_BOOTSTRAP_PASSWORD"
        },
        {
          "secret": "erp-authentik-bootstrap",
          "key": "bootstrap-password"
        }
      ]
    }
  ],
  "kubernetesSecrets": [
    {
      "name": "erp-sqlserver",
      "stringData": {
        "sa-password": "{sql-sa-password}",
        "sales-password": "{sales-db-password}",
        "purchasing-password": "{purchasing-db-password}",
        "inventory-password": "{inventory-db-password}",
        "fulfilment-password": "{fulfilment-db-password}"
      }
    },
    {
      "name": "erp-sqlserver-connection-strings",
      "stringData": {
        "sales": "Server=sqlserver.erp-local.svc.cluster.local,1433;Database=sales_db;User Id=sales_app;Password={sales-db-password};Encrypt=True;TrustServerCertificate=True",
        "purchasing": "Server=sqlserver.erp-local.svc.cluster.local,1433;Database=purchasing_db;User Id=purchasing_app;Password={purchasing-db-password};Encrypt=True;TrustServerCertificate=True",
        "inventory": "Server=sqlserver.erp-local.svc.cluster.local,1433;Database=inventory_db;User Id=inventory_app;Password={inventory-db-password};Encrypt=True;TrustServerCertificate=True",
        "fulfilment": "Server=sqlserver.erp-local.svc.cluster.local,1433;Database=fulfilment_db;User Id=fulfilment_app;Password={fulfilment-db-password};Encrypt=True;TrustServerCertificate=True"
      }
    },
    {
      "name": "erp-authentik-bootstrap",
      "stringData": {
        "secret-key": "{authentik-secret-key}",
        "postgresql-password": "{authentik-postgresql-password}",
        "bootstrap-password": "{authentik-bootstrap-password}"
      }
    }
  ]
}
